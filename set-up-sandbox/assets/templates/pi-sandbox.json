{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 30,
  "network": {
    "allowLocalBinding": false,
    "allowAllUnixSockets": false
  },
  "filesystem": {
    "denyRead": [
      "/home",
      "/Users",
      "~/Main",
      "~/Temporary",
      "~/.claude/.credentials.json",
      "~/.claude/projects",
      "~/.codex/auth.json",
      "~/.codex/sessions",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/sessions",
      "/run/docker.sock",
      "/var/run/docker.sock",
      "/run/podman/podman.sock"
    ],
    "allowRead": [
      ".",
      "~/.claude",
      "~/.codex",
      "~/.pi",
      "~/.gitconfig",
      "~/.local/bin",
      "~/.nvm",
      "~/.cargo",
      "~/.rustup",
      "~/.npm",
      "~/.cache"
    ],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyWrite": [
      ".pi",
      ".claude",
      ".codex",
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
