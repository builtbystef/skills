{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 5,
  "network": {
    "allowLocalBinding": false,
    "allowAllUnixSockets": false
  },
  "filesystem": {
    "denyRead": [
      "/home",
      "/Users",
      "~/Main",
      "~/Temporary",
      "/run/docker.sock",
      "/var/run/docker.sock",
      "/run/podman/podman.sock"
    ],
    "allowRead": [
      ".",
      "~/.gitconfig",
      "~/.local/bin",
      "~/.nvm",
      "~/.cargo",
      "~/.rustup",
      "~/.npm",
      "~/.cache"
    ],
    "allowWrite": [
      "."
    ],
    "denyWrite": [
      ".pi",
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
