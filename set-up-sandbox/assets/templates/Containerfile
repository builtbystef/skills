# The agent sandbox image for {{project}}. Build it and run it only through
# sandbox/start.sh. Everything installed here is reachable only from inside
# the sandbox.
FROM {{base-image}}

RUN apt-get update && \
    apt-get install -y \
        git \
        curl \
        ca-certificates \
        build-essential \
        ripgrep \
        jq \
        {{stack-packages}} \
    && rm -rf /var/lib/apt/lists/*

{{agent-cli-install-lines}}

# The sandbox runs as a user without privileges: agent CLIs (Claude Code,
# Codex) refuse their full-permission flags under root. The uid 1000 also
# agrees with the host user, through the runtime's userns/user flag, so that
# /workspace stays the host user's property.
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd --create-home --uid 1000 --shell /bin/bash agent
USER agent

WORKDIR /workspace
