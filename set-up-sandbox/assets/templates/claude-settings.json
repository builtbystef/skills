{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        ".",
        "~/.gitconfig",
        "~/.local/bin",
        "~/.nvm",
        "~/.cargo",
        "~/.rustup",
        "~/.npm",
        "~/.cache"
      ]
    }
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Read(~/Main/**)",
      "Edit(~/Main/**)",
      "Read(~/Temporary/**)",
      "Edit(~/Temporary/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Read(~/.codex/**)",
      "Read(~/.pi/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.local/share/keyrings/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.codex/**)",
      "Edit(~/.pi/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.netrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.claude/**)",
      "Edit(.codex/**)",
      "Edit(.pi/**)",
      "Edit(.mcp.json)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)"
    ]
  }
}
